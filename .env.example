# Database Configuration
DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Admin Credentials (Override defaults)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password
ADMIN_NAME=Super Administrator

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Server Configuration
NODE_ENV=development
PORT=5000

# Supabase Configuration (Optional - for file upload features)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Custom domain configuration for production
# DOMAIN=example.com

# NRSA Store / Paystack (keep secret key server-side)
# PAYSTACK_SECRET_KEY=sk_test_your-secret-key
# PUBLIC_APP_URL=https://nrsa.com.ng
# STORE_ADMIN_EMAIL=store-admin@nrsa.com.ng

# Transactional email
# RESEND_API_KEY=re_your-key
# RESEND_FROM_EMAIL=store@nrsa.com.ng
